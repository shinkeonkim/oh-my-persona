{
  "name": "@aws-study/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc -p tsconfig.json --incremental false && bun run --parallel dev:compile dev:serve",
    "dev:compile": "tsc -p tsconfig.json --watch --preserveWatchOutput --incremental false",
    "dev:serve": "bun --watch dist/main.js",
    "build": "tsc -p tsconfig.json --incremental false",
    "start": "bun run dist/main.js",
    "create-admin": "bun run src/cli/create-admin.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@aws-study/db": "workspace:*",
    "@aws-study/shared": "workspace:*",
    "@fastify/static": "10.1.2",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-fastify": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "6.5.0",
    "@node-rs/argon2": "2.0.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.7.2",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.2",
    "typescript": "5.9.3"
  }
}
