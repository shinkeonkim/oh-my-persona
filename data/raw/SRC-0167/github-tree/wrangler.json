{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "terraform-study",
  "compatibility_date": "2026-08-02",
  "assets": {
    "directory": "dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "terraform-study.shinkeonkim.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
