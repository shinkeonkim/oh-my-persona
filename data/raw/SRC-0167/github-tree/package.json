{
  "name": "terraform-associate-004-study-guide",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "sources:update": "bun scripts/sync-official-sources.mjs",
    "tutorials:update": "bun scripts/sync-tutorial-catalog.mjs",
    "content:check": "bun scripts/check-question-bank.mjs",
    "security:check": "bun test scripts/security-headers.test.mjs",
    "dev": "astro dev",
    "build": "astro check && bun run content:check && bun run security:check && astro build",
    "preview": "astro preview",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.6",
    "astro": "^7.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3",
    "wrangler": "^4.118.0"
  }
}
